# Local package-manager state. Both are redirected inside the workspace by
# .npmrc, and neither is source: formatting them would be pointless churn.
.npm-cache/
.pnpm-store/

# Build output.
lib/
dist/

# Task briefs. These are generated by the external workbench that drives the
# implementation plan, and they are not tracked by this repository. Formatting
# them would rewrite files this project does not own and cannot review, and
# `pnpm run format:check` would otherwise fail on any checkout that has them.
# Excluded by directory rather than by listing each file, so a new brief does not
# break the format gate the moment it is written.
Taskmd/
